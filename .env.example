# ApplyPilot Environment Configuration
# Prefer: run `applypilot init` (writes ~/.applypilot/.env)
# Or copy this file to ~/.applypilot/.env and fill in values.

# --- LLM Provider for score / tailor / cover (pick one) ---
GEMINI_API_KEY=           # Free: https://aistudio.google.com/apikey  (recommended)
# OPENAI_API_KEY=         # OpenAI (e.g. gpt-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local (Ollama / llama.cpp OpenAI-compatible)
LLM_MODEL=gemini-2.0-flash

# --- Auto-Apply agent backend ---
# Default is Grok Build (xAI). Claude Code remains available as a fallback.
APPLY_BACKEND=grok          # grok | claude
# APPLY_GROK_MODEL=grok-4.5
# APPLY_CLAUDE_MODEL=haiku
# GROK_BIN=                 # override path to grok CLI
# XAI_API_KEY=              # if Grok CLI needs API key (else use grok login)
# GROK_MODEL=grok-4.5

# Apply runtime (laptop-friendly defaults)
# APPLY_TIMEOUT=420         # seconds per application attempt
# APPLY_MAX_TURNS=60        # max agent turns per job
# APPLY_WORKERS=1

# CAPSOLVER_API_KEY=        # CAPTCHA solving during auto-apply
# CHROME_PATH=              # Override Chrome binary if not auto-detected

# --- Optional: Brian-style Google dork discovery ---
# SERPAPI_KEY=              # recommended for --brians
# BRIANS_ALLOW_SCRAPE=0     # set 1 only if you accept fragile HTML scrape
# BRIANS_MIN_GAP_SEC=8

# --- Optional: resume-tailor 1-page PDF bridge ---
# https://github.com/lohithveerepalli/resume-tailor
# RESUME_TAILOR_PATH=/path/to/resume-tailor
# RESUME_TAILOR_MASTER=/path/to/master_resume.yaml

# --- Paths (optional) ---
# APPLYPILOT_DIR=           # Default: ~/.applypilot

# --- Proxy (optional, for scraping) ---
# PROXY=host:port:user:pass
