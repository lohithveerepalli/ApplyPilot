# ApplyPilot Environment Configuration
# Prefer: run `applypilot init` (writes ~/.applypilot/.env)
# Or copy this file to ~/.applypilot/.env and fill in values.

# --- LLM Provider (pick one) ---
GEMINI_API_KEY=           # Free: https://aistudio.google.com/apikey  (recommended)
# OPENAI_API_KEY=         # OpenAI (e.g. gpt-4o-mini)
# LLM_URL=http://127.0.0.1:8080/v1  # Local (Ollama / llama.cpp OpenAI-compatible)
LLM_MODEL=gemini-2.0-flash

# --- Auto-Apply (optional) ---
# CAPSOLVER_API_KEY=      # CAPTCHA solving during auto-apply
# CHROME_PATH=            # Override Chrome binary if not auto-detected

# --- Paths (optional) ---
# APPLYPILOT_DIR=         # Default: ~/.applypilot

# --- Proxy (optional, for scraping) ---
# PROXY=host:port:user:pass
